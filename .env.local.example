# --- Shopify Storefront API (commerce source of truth) ---
# Your *.myshopify.com domain, e.g. dogedin.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Shopify admin → Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STOREFRONT_TOKEN=

# --- Supabase (custom content: things-to-do reviews, dog profiles, auth) ---
# Powers /things-to-do, /register, /dog/{slug}, /dogs and /account. Run the SQL
# in supabase/ (spots.sql, dogs.sql) once these are set. Dog registration uses
# Supabase Auth (email + password) and Storage (bucket "dog-photos") — no extra
# secret needed beyond the two below. For a frictionless v1, turn OFF "Confirm
# email" in Supabase → Authentication → Providers, or configure SMTP.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
