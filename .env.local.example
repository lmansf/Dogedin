# --- Shopify Storefront API (commerce source of truth) ---
# Your *.myshopify.com domain, e.g. dogedin.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Shopify admin → Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STOREFRONT_TOKEN=

# --- Supabase (custom content: things-to-do reviews, dog profiles, auth) ---
# Powers /things-to-do, /register, /dog/{slug}, /dogs and /account. Run the SQL
# in supabase/schema.sql once these are set. Dog registration uses
# Supabase Auth (email + password) and Storage (bucket "dog-photos") — no extra
# secret needed beyond the two below. For a frictionless v1, turn OFF "Confirm
# email" in Supabase → Authentication → Providers, or configure SMTP.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY — never expose). Used by the Stripe webhook to
# write membership status. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL, e.g. https://dogedin.com — used for QR/tag links and Stripe
# checkout redirects.
NEXT_PUBLIC_SITE_URL=

# --- Phase 3: auto-pulled content feeds ---
# Public iCal (.ics) URL for the /events page (e.g. a Google Calendar's public
# iCal address, or any site's iCal export). Leave blank to show an empty state.
EVENTS_ICS_URL=
# Instagram Graph API (official). Requires an IG Business/Creator account linked
# to a Facebook Page + app, and a long-lived token. Leave blank for a "follow
# us" fallback card. NEXT_PUBLIC_INSTAGRAM_HANDLE is used for that fallback link.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# --- Phase 5: membership billing (Stripe) ---
# Create a recurring Product/Price in Stripe and put the Price id here — this is
# where the membership amount is set (confirm the price before going live).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From the Stripe webhook endpoint you create (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=
# Display-only price label shown on /membership, e.g. "$5/mo".
NEXT_PUBLIC_MEMBERSHIP_PRICE_LABEL=
