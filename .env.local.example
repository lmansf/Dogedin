# --- Shopify Storefront API (commerce source of truth) ---
# Your *.myshopify.com domain, e.g. dogedin-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Storefront API access token (Shopify admin → Settings → Apps → Develop apps → Storefront API)
SHOPIFY_STOREFRONT_TOKEN=
# Scoping products to specific pages: the site pulls a page's products from a
# named Shopify COLLECTION (getCollection(handle) in lib/shopify.ts), so which
# items appear where is managed entirely in the Shopify admin — no code change.
# Collections in use:
#   dog-tags → the physical lost-dog tag(s) offered right after registration on
#              /dog/{slug}?welcome=1. Create a collection with the handle
#              "dog-tags" and add your tag product(s); the offer hides itself
#              until that collection has at least one product.

# --- Supabase (custom content: things-to-do reviews, dog profiles, auth) ---
# Powers /things-to-do, /register, /dog/{slug}, /dogs and /account. Run the SQL
# in supabase/schema.sql once these are set. Dog registration uses
# Supabase Auth (email + password) and Storage (bucket "dog-photos") — no extra
# secret needed beyond the two below. For a frictionless v1, turn OFF "Confirm
# email" in Supabase → Authentication → Providers, or configure SMTP.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SERVER ONLY — never expose). Used by the Stripe webhook to
# write membership status. Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute site URL, e.g. https://dogedin.com — used for QR/tag links and Stripe
# checkout redirects.
NEXT_PUBLIC_SITE_URL=

# --- Phase 3: auto-pulled content feeds ---
# Public iCal (.ics) URL for the /events page (e.g. a Google Calendar's public
# iCal address, or any site's iCal export). Leave blank to show an empty state.
EVENTS_ICS_URL=
# Instagram Graph API (official). Requires an IG Business/Creator account linked
# to a Facebook Page + app, and a long-lived token. Leave blank for a "follow
# us" fallback card. NEXT_PUBLIC_INSTAGRAM_HANDLE is used for that fallback link.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
NEXT_PUBLIC_INSTAGRAM_HANDLE=

# --- Business Insights subscription (paid stats portal on the media-kit site) ---
# Monthly price per business, in cents (default 1500 = $15/mo). Keep the
# display label NEXT_PUBLIC_INSIGHTS_PRICE_LABEL on the media-kit deployment in
# sync when changing this.
INSIGHTS_MONTHLY_CENTS=
# The media-kit deployment's URL (e.g. https://dogedin-media-kit.vercel.app) —
# where buyers land after insights checkout. Falls back to NEXT_PUBLIC_SITE_URL.
BUSINESS_PORTAL_URL=

# --- Phase 5: membership billing (Stripe) ---
# Create a recurring Product/Price in Stripe and put the Price id here — this is
# where the membership amount is set (confirm the price before going live).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# From the Stripe webhook endpoint you create (events: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted).
STRIPE_WEBHOOK_SECRET=
# Display-only price label shown on /membership, e.g. "$5/mo".
NEXT_PUBLIC_MEMBERSHIP_PRICE_LABEL=

# --- Dog-of-the-day Instagram pipeline ---
# Runs in Supabase Edge Functions, NOT here — its secrets (ANTHROPIC_API_KEY,
# IG_USER_ID, IG_ACCESS_TOKEN, ADMIN_NOTIFY_WEBHOOK) are set with
# `supabase secrets set`. See docs/instagram-pipeline.md. Once the pipeline's
# feed cache is live, the INSTAGRAM_* vars above become an optional fallback.

# --- Dog social: friends + photo feed ---
# Also runs in Supabase Edge Functions (`moderate-photo`). Reuses the same
# ANTHROPIC_API_KEY secret above (vision-capable) — no new secret needed.
# Optional: PHOTO_MODERATION_MODEL (defaults to MODERATION_MODEL, then
# claude-haiku-4-5). Deploy with `supabase functions deploy moderate-photo`.

# --- Ad inquiries: email notification ---
# Runs in a Supabase Edge Function (`notify-ad-inquiry`), invoked by the
# /advertise form right after it inserts. Get a free API key at resend.com,
# then `supabase secrets set RESEND_API_KEY=...` and
# `supabase functions deploy notify-ad-inquiry`. Without RESEND_API_KEY set,
# the function no-ops — inquiries still land in ad_inquiries either way.
# Required for team notifications: AD_INQUIRY_NOTIFY_EMAIL (no default — the
# function skips sending when unset; inquiries still land in ad_inquiries),
# AD_INQUIRY_FROM_EMAIL (defaults to Resend's shared onboarding@resend.dev
# sender — swap in a verified domain address once you have one).
