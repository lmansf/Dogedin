<script src="{{ 'dogedin-community.js' | asset_url }}" defer></script>
{%- comment -%}
  Dog-friendly Dunedin guide — approved businesses from public_businesses,
  with the full Business Insights engagement counting (record_business_stat:
  view / website / phone / directions / offer_unlock). Every tap the shop
  records feeds the same per-business, per-day aggregates the paid Insights
  portal sells back to businesses. Aggregates only — no visitor identity.
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
<h2 class="h1" style="margin:0 0 0.4rem;">{{ section.settings.heading | escape }}</h2>
<p style="margin:0 0 1.6rem;">The community&#39;s favorite dog-friendly spots — reviewed by the pack on dogedin. Some carry a member deal; tap to unlock it.</p>
<div id="dgd-guide" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(28rem,1fr));gap:1.8rem;"></div>
</div>
</div>
<script>
(function () {
  function boot() {
    var D = window.Dogedin; if (!D) return setTimeout(boot, 60);
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; }); };
    var mount = document.getElementById("dgd-guide");
    var stat = function (id, s) { D.rpc("record_business_stat", { p_business_id: id, p_stat: s }).catch(function () {}); };
    var BTN = "border:0.2rem solid rgb(var(--color-foreground));padding:0.5rem 1rem;font:inherit;font-weight:800;font-size:1.2rem;text-transform:uppercase;letter-spacing:0.05rem;cursor:pointer;background:transparent;color:rgb(var(--color-foreground));text-decoration:none;display:inline-block;";
    D.select("public_businesses?select=id,slug,name,category,neighborhood,description,image,dog_friendly,phone,website,address,offer&order=name.asc&limit={{ section.settings.limit }}")
      .then(function (rows) {
        rows = rows || [];
        if (!rows.length) { mount.parentElement.parentElement.style.display = "none"; return; }
        mount.innerHTML = rows.map(function (b, i) {
          var img = "";
          if (b.image) {
            var src = /^https?:/.test(b.image) ? b.image : "https://dogedin.com" + b.image;
            img = '<div style="aspect-ratio:16/9;border-bottom:0.25rem solid rgb(var(--color-foreground));background:#fff;"><img src="' + esc(src) + '" alt="' + esc(b.name) + '" loading="lazy" style="width:100%;height:100%;object-fit:cover;"></div>';
          }
          var meta = [b.category, b.neighborhood].filter(Boolean).map(esc).join(" &middot; ");
          var actions = "";
          if (b.website) actions += '<a class="dgd-g-act" data-i="' + i + '" data-stat="website" href="' + esc(b.website) + '" target="_blank" rel="noopener" style="' + BTN + '">Website</a>';
          if (b.phone) actions += '<a class="dgd-g-act" data-i="' + i + '" data-stat="phone" href="tel:' + esc(b.phone) + '" style="' + BTN + '">Call</a>';
          var q = encodeURIComponent(b.name + ", " + (b.address || "Dunedin, FL"));
          actions += '<a class="dgd-g-act" data-i="' + i + '" data-stat="directions" href="https://www.google.com/maps/search/?api=1&query=' + q + '" target="_blank" rel="noopener" style="' + BTN + '">Directions</a>';
          var offer = "";
          if (b.offer && b.offer.label) {
            offer = '<div style="margin-top:0.8rem;">' +
              '<button class="dgd-g-offer" data-i="' + i + '" style="' + BTN + 'background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));">\uD83C\uDF9F Member deal: ' + esc(b.offer.label) + "</button>" +
              '<div class="dgd-g-offer-detail" data-i="' + i + '" style="display:none;border:0.2rem dashed rgb(var(--color-foreground));padding:0.8rem 1rem;margin-top:0.6rem;font-weight:700;"></div></div>';
          }
          return '<div class="dgd-g-card" data-i="' + i + '" style="border:0.25rem solid rgb(var(--color-foreground));box-shadow:0.5rem 0.5rem 0 rgb(var(--color-foreground));background:rgb(var(--color-background));color:rgb(var(--color-foreground));display:flex;flex-direction:column;">' + img +
            '<div style="padding:1.2rem 1.4rem;display:flex;flex-direction:column;flex:1;">' +
            '<h3 style="margin:0;font-size:1.8rem;">' + esc(b.name) + "</h3>" +
            (meta ? '<p style="margin:0.2rem 0 0;font-size:1.1rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08rem;opacity:0.65;">' + meta + "</p>" : "") +
            (b.description ? '<p style="margin:0.6rem 0 0;opacity:0.85;">' + esc(b.description) + "</p>" : "") +
            offer +
            '<div style="display:flex;gap:0.8rem;flex-wrap:wrap;margin-top:auto;padding-top:1rem;">' + actions + "</div>" +
            "</div></div>";
        }).join("");

        // Listing views: each card counted once after >=50% visible for >=1s.
        var seen = {}, timers = {};
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            var i = entry.target.getAttribute("data-i");
            if (entry.intersectionRatio >= 0.5) {
              if (!timers[i] && !seen[i]) timers[i] = setTimeout(function () {
                seen[i] = true; stat(rows[i].id, "view");
              }, 1000);
            } else if (timers[i]) { clearTimeout(timers[i]); timers[i] = null; }
          });
        }, { threshold: [0, 0.5, 1] });
        mount.querySelectorAll(".dgd-g-card").forEach(function (el) { io.observe(el); });

        // Website / call / directions taps (fire-and-forget, nav proceeds).
        mount.querySelectorAll(".dgd-g-act").forEach(function (a) {
          a.addEventListener("click", function () {
            stat(rows[a.getAttribute("data-i")].id, a.getAttribute("data-stat"));
          });
        });

        // Offer unlock: reveal detail + code, counted once per page view.
        var unlocked = {};
        mount.querySelectorAll(".dgd-g-offer").forEach(function (btn) {
          btn.addEventListener("click", function () {
            var i = btn.getAttribute("data-i"), b = rows[i];
            var box = mount.querySelector('.dgd-g-offer-detail[data-i="' + i + '"]');
            if (!box) return;
            box.innerHTML = esc((b.offer && b.offer.detail) || (b.offer && b.offer.label) || "") +
              ((b.offer && b.offer.code) ? ' &middot; code: <span style="letter-spacing:0.15rem;">' + esc(b.offer.code) + "</span>" : "");
            box.style.display = box.style.display === "none" ? "block" : "none";
            if (box.style.display === "block" && !unlocked[i]) { unlocked[i] = true; stat(b.id, "offer_unlock"); }
          });
        });
      })
      .catch(function () { mount.parentElement.parentElement.style.display = "none"; });
  }
  boot();
})();
</script>
{% schema %}
{
  "name": "Dog-friendly guide",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dog-friendly Dunedin" },
    { "type": "range", "id": "limit", "min": 3, "max": 24, "step": 3, "label": "Businesses to show", "default": 9 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "presets": [{ "name": "Dog-friendly guide" }]
}
{% endschema %}
