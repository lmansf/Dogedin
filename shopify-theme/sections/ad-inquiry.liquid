<script src="{{ 'dogedin-community.js' | asset_url }}" defer></script>
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

<div style="border: 0.3rem solid rgb(var(--color-foreground)); box-shadow: 0.6rem 0.6rem 0 rgb(var(--color-foreground)); background: rgb(var(--color-background)); padding: 2rem 2.4rem; max-width: 56rem; margin: 0 auto;">
  <h2 class="h1" style="margin:0 0 0.6rem;">Raise your hand</h2>
  <p style="margin:0 0 1.6rem;">Tell us about your business — the inquiry lands straight in the Dogedin admin queue, and we&#39;ll reply with current flat-monthly rates.</p>
  <form id="dgd-inq" style="display:flex;flex-direction:column;gap:1rem;">
    <input style="width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;" id="dgd-inq-biz" placeholder="Business name *" maxlength="120" required>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(20rem,1fr));gap:1rem;">
      <input style="width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;" id="dgd-inq-name" placeholder="Your name *" maxlength="80" required>
      <input style="width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;" id="dgd-inq-email" type="email" placeholder="Email *" maxlength="120" required>
    </div>
    <textarea style="width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;resize:vertical;" id="dgd-inq-msg" rows="4" maxlength="2000" placeholder="What are you interested in? (placement, dates, questions)"></textarea>
    <p id="dgd-inq-err" style="color:#a6332e;font-weight:700;margin:0;"></p>
    <button style="border:0.3rem solid rgb(var(--color-foreground));box-shadow:0.4rem 0.4rem 0 rgb(var(--color-foreground));background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));padding:1rem 1.6rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08rem;cursor:pointer;font-size:1.3rem;" type="submit" id="dgd-inq-btn">Send inquiry</button>
  </form>
</div>
<script>
(function () {
  function boot() {
    var D = window.Dogedin; if (!D) return setTimeout(boot, 60);
    var form = document.getElementById("dgd-inq"); if (!form) return;
    form.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var err = document.getElementById("dgd-inq-err");
      var btn = document.getElementById("dgd-inq-btn");
      err.style.color = "#a6332e"; err.textContent = ""; btn.disabled = true; btn.textContent = "Sending…";
      try {
        await D.insert("ad_inquiries", {
          business_name: document.getElementById("dgd-inq-biz").value.trim(),
          contact_name: document.getElementById("dgd-inq-name").value.trim(),
          email: document.getElementById("dgd-inq-email").value.trim(),
          message: document.getElementById("dgd-inq-msg").value.trim() || null
        });
        form.innerHTML = '<p style="font-weight:800;font-size:1.6rem;margin:0;">Got it — thanks! 🐾 We&#39;ll be in touch about rates and dates.</p>';
      } catch (e) {
        err.textContent = e.message || "Something went wrong — try again?";
        btn.disabled = false; btn.textContent = "Send inquiry";
      }
    });
  }
  boot();
})();
</script>
</div>
</div>
{% schema %}
{
  "name": "Ad inquiry form (Supabase)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Ad inquiry form (Supabase)"
    }
  ]
}
{% endschema %}
