<script src="{{ 'dogedin-community.js' | asset_url }}" defer></script>
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

<div id="dgd-portal" style="border: 0.3rem solid rgb(var(--color-foreground)); box-shadow: 0.6rem 0.6rem 0 rgb(var(--color-foreground)); background: rgb(var(--color-background)); padding: 2rem 2.4rem; max-width: 68rem; margin: 0 auto;">
  <p style="margin:0 0 1rem;font-size:1.1rem;font-weight:800;text-transform:uppercase;letter-spacing:0.13rem;opacity:0.7;">🏪 Business dashboard</p>
  <h2 class="h1" style="margin:0 0 0.6rem;">Your business on Dogedin</h2>
  <p style="margin:0 0 1.6rem;">See who’s finding you, and put your business in front of Dunedin’s dog people.</p>
  <div id="dgd-portal-body"><p style="opacity:0.6;font-weight:700;">Loading…</p></div>
</div>

<script>
(function () {
  function boot() {
    var D = window.Dogedin; if (!D) return setTimeout(boot, 60);
    var body = document.getElementById("dgd-portal-body");
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; }); };
    var I = 'width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;';
    var B = 'border:0.3rem solid rgb(var(--color-foreground));box-shadow:0.4rem 0.4rem 0 rgb(var(--color-foreground));background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));padding:1rem 1.6rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08rem;cursor:pointer;font-size:1.3rem;text-decoration:none;display:inline-block;';
    var LINK = 'background:none;border:none;font:inherit;font-weight:800;text-transform:uppercase;font-size:1.1rem;text-decoration:underline;cursor:pointer;color:inherit;padding:0;';

    function authView(msg) {
      body.innerHTML =
        (msg ? '<p style="font-weight:700;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;margin:0 0 1.2rem;">' + esc(msg) + "</p>" : "") +
        '<p style="margin:0 0 1.2rem;">Sign in with the email you claimed your business with. New here? Create the account with that same email and it’ll link up once we verify your claim.</p>' +
        '<form id="dgd-p-auth" style="display:flex;flex-direction:column;gap:1rem;max-width:42rem;">' +
        '<input style="' + I + '" type="email" id="dgd-p-email" placeholder="Email" required>' +
        '<input style="' + I + '" type="password" id="dgd-p-pass" placeholder="Password (8+ characters)" minlength="8" required>' +
        '<div style="display:flex;gap:1rem;flex-wrap:wrap;">' +
        '<button style="' + B + '" type="submit" data-mode="signin">Sign in</button>' +
        '<button style="' + B + 'opacity:0.85;" type="submit" data-mode="signup">Create account</button></div>' +
        '<button type="button" id="dgd-p-forgot" style="' + LINK + 'text-align:left;">Forgot password?</button>' +
        '<p id="dgd-p-err" style="color:#a6332e;font-weight:700;margin:0;"></p></form>';
      var form = document.getElementById("dgd-p-auth"), errEl = document.getElementById("dgd-p-err"), mode = "signin";
      form.querySelectorAll("button[data-mode]").forEach(function (b) { b.addEventListener("click", function () { mode = b.getAttribute("data-mode"); }); });
      document.getElementById("dgd-p-forgot").addEventListener("click", async function () {
        errEl.style.color = "inherit";
        try { await D.resetPassword(document.getElementById("dgd-p-email").value); errEl.textContent = "If that email has an account, a reset link is on its way (finishes on dogedin.com)."; }
        catch (e) { errEl.style.color = "#a6332e"; errEl.textContent = e.message; }
      });
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault(); errEl.style.color = "#a6332e"; errEl.textContent = "";
        try {
          if (mode === "signup") { var r = await D.signUp(document.getElementById("dgd-p-email").value, document.getElementById("dgd-p-pass").value); if (r.confirm) { errEl.style.color = "inherit"; errEl.textContent = "Check your email to confirm your account, then sign in here."; return; } }
          else { await D.signIn(document.getElementById("dgd-p-email").value, document.getElementById("dgd-p-pass").value); }
          render();
        } catch (e) { errEl.textContent = e.message; }
      });
    }

    function promoBox(name) {
      return '<div style="border:0.25rem solid rgb(var(--color-foreground));background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));padding:1.4rem 1.6rem;margin:1.2rem 0 0;">' +
        '<p style="margin:0 0 0.4rem;font-weight:800;font-size:1.7rem;">📣 Put ' + esc(name) + ' in front of the pack</p>' +
        '<p style="margin:0 0 1rem;font-weight:600;">Sponsor the homepage banner or the Community Favorites ribbon — the same dog people already finding you here, every day. Honest per-slot stats included.</p>' +
        '<a href="/pages/advertise" style="' + B + 'background:rgb(var(--color-background));color:rgb(var(--color-foreground));">Advertise your business →</a></div>';
    }

    async function render() {
      body.innerHTML = '<p style="opacity:0.6;font-weight:700;">Loading…</p>';
      var sess = await D.getSession();
      if (!sess) return authView();
      var token = sess.access_token, biz;
      try { biz = await D.rpc("my_portal_businesses", {}, token); } catch (e) { biz = null; }
      biz = biz || [];

      var head = '<div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:0 0 1.4rem;flex-wrap:wrap;">' +
        '<span style="font-weight:700;opacity:0.7;">Signed in as ' + esc(sess.user.email) + '</span>' +
        '<button id="dgd-p-out" style="' + LINK + '">Sign out</button></div>';

      if (!biz.length) {
        body.innerHTML = head +
          '<div style="border:0.2rem dashed rgb(var(--color-foreground));padding:1.4rem 1.6rem;">' +
          '<p style="margin:0 0 0.6rem;font-weight:800;font-size:1.6rem;">No business linked to this email yet</p>' +
          '<p style="margin:0 0 0.8rem;">If you’ve claimed a listing, it shows up here as soon as we verify you (a quick call or hello in person). Not claimed yet? Find your spot in the guide and hit <strong>Claim this business</strong>.</p>' +
          '<a href="/pages/dog-friendly-dunedin" style="' + LINK + 'color:#1fa89b;">Open the guide →</a></div>';
        document.getElementById("dgd-p-out").addEventListener("click", function () { D.signOut(); render(); });
        return;
      }

      var cards = await Promise.all(biz.map(async function (b) {
        var ins = null;
        try { ins = await D.rpc("business_insights", { p_business_id: b.id }, token); } catch (e) {}
        var status = b.status === "approved" ? '<span style="border:0.2rem solid #211e18;background:#1f5c4a;color:#f4e9ce;padding:0.1rem 0.6rem;font-size:1rem;text-transform:uppercase;">Live</span>'
          : '<span style="border:0.2rem solid #211e18;background:#c99a2e;color:#211e18;padding:0.1rem 0.6rem;font-size:1rem;text-transform:uppercase;">Under review</span>';
        var stats = "";
        if (ins) {
          var views = ins.views_30d != null ? ins.views_30d : ((ins.totals_30d && ins.totals_30d.view) || 0);
          var rc = (ins.reviews && ins.reviews.count) || 0;
          var ra = (ins.reviews && ins.reviews.avg) || 0;
          stats = '<div style="display:flex;gap:1.6rem;flex-wrap:wrap;margin:1rem 0 0;">' +
            '<div><p style="margin:0;font-size:2.6rem;font-weight:800;">' + views + '</p><p style="margin:0;font-size:1.1rem;font-weight:700;opacity:0.6;text-transform:uppercase;letter-spacing:0.05rem;">Views · 30 days</p></div>' +
            '<div><p style="margin:0;font-size:2.6rem;font-weight:800;">' + rc + '</p><p style="margin:0;font-size:1.1rem;font-weight:700;opacity:0.6;text-transform:uppercase;letter-spacing:0.05rem;">Reviews' + (ra ? ' · ' + ra + '★' : '') + '</p></div></div>' +
            '<p style="margin:0.8rem 0 0;font-size:1.1rem;opacity:0.6;font-weight:700;">Website / call / directions taps are tracked too — the full breakdown is part of Insights.</p>';
        }
        return '<div style="border:0.25rem solid rgb(var(--color-foreground));box-shadow:0.5rem 0.5rem 0 rgb(var(--color-foreground));background:rgb(var(--color-background));padding:1.4rem 1.6rem;margin:0 0 1.6rem;">' +
          '<p style="margin:0;display:flex;gap:0.8rem;align-items:center;flex-wrap:wrap;"><span style="font-weight:800;font-size:2rem;">' + esc(b.name) + '</span>' + status + '</p>' +
          (b.category ? '<p style="margin:0.2rem 0 0;font-size:1.2rem;opacity:0.6;font-weight:700;text-transform:uppercase;letter-spacing:0.05rem;">' + esc(b.category) + '</p>' : "") +
          stats + promoBox(b.name) + "</div>";
      }));

      body.innerHTML = head + cards.join("");
      document.getElementById("dgd-p-out").addEventListener("click", function () { D.signOut(); render(); });
    }
    render();
  }
  boot();
})();
</script>
</div>
</div>
{% schema %}
{
  "name": "Business dashboard",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "presets": [{ "name": "Business dashboard" }]
}
{% endschema %}
