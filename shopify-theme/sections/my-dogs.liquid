<script src="{{ 'dogedin-community.js' | asset_url }}" defer></script>
<div class="color-{{ section.settings.color_scheme }} gradient">
<div class="page-width" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">

<div id="dgd-mydogs" style="border: 0.3rem solid rgb(var(--color-foreground)); box-shadow: 0.6rem 0.6rem 0 rgb(var(--color-foreground)); background: rgb(var(--color-background)); padding: 2rem 2.4rem; max-width: 64rem; margin: 0 auto;">
  <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin:0 0 0.6rem;">
    <div>
      <p style="margin:0 0 0.6rem;font-size:1.1rem;font-weight:800;text-transform:uppercase;letter-spacing:0.13rem;opacity:0.7;">🐾 Your pack</p>
      <h2 class="h1" style="margin:0;">My dogs</h2>
    </div>
    <a href="/pages/register-your-dog" style="border:0.3rem solid rgb(var(--color-foreground));box-shadow:0.4rem 0.4rem 0 rgb(var(--color-foreground));background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));padding:0.8rem 1.4rem;font-weight:800;text-transform:uppercase;letter-spacing:0.06rem;text-decoration:none;font-size:1.2rem;">+ Register a dog</a>
  </div>
  <p style="margin:0.6rem 0 1.6rem;">Edit a profile, grab its tag code, or remove a dog. Only you can see or change your own dogs — the database enforces it.</p>
  <div id="dgd-mydogs-body"><p style="opacity:0.6;font-weight:700;">Loading…</p></div>
</div>

<script>
(function () {
  var LOOKUP = "/pages/found";
  function boot() {
    var D = window.Dogedin; if (!D) return setTimeout(boot, 60);
    var body = document.getElementById("dgd-mydogs-body");
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return "&#" + c.charCodeAt(0) + ";"; }); };
    var I = 'width:100%;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;font:inherit;background:#fff;color:#211e18;';
    var B = 'border:0.3rem solid rgb(var(--color-foreground));box-shadow:0.4rem 0.4rem 0 rgb(var(--color-foreground));background:rgba(var(--color-button),1);color:rgb(var(--color-button-text));padding:1rem 1.6rem;font-weight:800;text-transform:uppercase;letter-spacing:0.08rem;cursor:pointer;font-size:1.3rem;';
    var SMALL = 'background:none;border:none;font:inherit;font-weight:800;text-transform:uppercase;font-size:1.1rem;text-decoration:underline;cursor:pointer;color:inherit;padding:0;';

    // Sign-in / create account — same account as registration and dogedin.com.
    function authView(msg) {
      body.innerHTML =
        (msg ? '<p style="font-weight:700;border:0.2rem solid rgb(var(--color-foreground));padding:0.8rem 1rem;margin:0 0 1.2rem;">' + esc(msg) + "</p>" : "") +
        '<p style="margin:0 0 1.2rem;">Sign in to see the dogs you&#39;ve registered.</p>' +
        '<form id="dgd-m-auth" style="display:flex;flex-direction:column;gap:1rem;max-width:42rem;">' +
        '<input style="' + I + '" type="email" id="dgd-m-email" placeholder="Email" required>' +
        '<input style="' + I + '" type="password" id="dgd-m-pass" placeholder="Password (8+ characters)" minlength="8" required>' +
        '<div style="display:flex;gap:1rem;flex-wrap:wrap;">' +
        '<button style="' + B + '" type="submit" data-mode="signin">Sign in</button>' +
        '<button style="' + B + 'opacity:0.85;" type="submit" data-mode="signup">Create account</button></div>' +
        '<button type="button" id="dgd-m-forgot" style="' + SMALL + 'text-align:left;">Forgot password?</button>' +
        '<p id="dgd-m-auth-err" style="color:#a6332e;font-weight:700;margin:0;"></p></form>';
      var form = document.getElementById("dgd-m-auth"), errEl = document.getElementById("dgd-m-auth-err"), mode = "signin";
      form.querySelectorAll("button[data-mode]").forEach(function (b) {
        b.addEventListener("click", function () { mode = b.getAttribute("data-mode"); });
      });
      document.getElementById("dgd-m-forgot").addEventListener("click", async function () {
        errEl.style.color = "inherit";
        try { await D.resetPassword(document.getElementById("dgd-m-email").value); errEl.textContent = "If that email has an account, a reset link is on its way (finishes on dogedin.com)."; }
        catch (e) { errEl.style.color = "#a6332e"; errEl.textContent = e.message; }
      });
      form.addEventListener("submit", async function (ev) {
        ev.preventDefault(); errEl.style.color = "#a6332e"; errEl.textContent = "";
        var email = document.getElementById("dgd-m-email").value, pass = document.getElementById("dgd-m-pass").value;
        try {
          if (mode === "signup") { var r = await D.signUp(email, pass); if (r.confirm) { errEl.style.color = "inherit"; errEl.textContent = "Check your email to confirm your account, then sign in here."; return; } }
          else { await D.signIn(email, pass); }
          render();
        } catch (e) { errEl.textContent = e.message; }
      });
    }

    async function listView(sess) {
      body.innerHTML = '<p style="opacity:0.6;font-weight:700;">Loading your dogs…</p>';
      var token = sess.access_token, dogs;
      try { dogs = await D.select("dog_profiles?select=id,slug,tag_code,dog_name,breed,bio,photo_path,lost_contact_opt_in&order=created_at.desc", token); }
      catch (e) { body.innerHTML = '<p style="color:#a6332e;font-weight:700;">Couldn&#39;t load your dogs: ' + esc(e.message) + "</p>"; return; }
      dogs = dogs || [];

      var head =
        '<div style="display:flex;justify-content:space-between;gap:1rem;align-items:center;margin:0 0 1.2rem;">' +
        '<span style="font-weight:700;opacity:0.7;">Signed in as ' + esc(sess.user.email) + "</span>" +
        '<button id="dgd-m-out" style="' + SMALL + '">Sign out</button></div>';

      if (!dogs.length) {
        body.innerHTML = head + '<div style="border:0.2rem solid rgb(var(--color-foreground));padding:1.2rem;font-weight:700;">You haven&#39;t registered a dog yet. <a href="/pages/register-your-dog" style="text-decoration:underline;color:inherit;font-weight:800;">Register one →</a></div>';
        document.getElementById("dgd-m-out").addEventListener("click", function () { D.signOut(); render(); });
        return;
      }

      var html = head;
      dogs.forEach(function (d) {
        var img = d.photo_path ? D.photoUrl(d.photo_path) : null;
        html +=
          '<div style="border:0.2rem solid rgb(var(--color-foreground));background:#fff;color:#211e18;padding:1rem;margin:0 0 1rem;">' +
          '<div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">' +
          (img ? '<img src="' + esc(img) + '" alt="' + esc(d.dog_name) + '" style="height:6rem;width:6rem;object-fit:cover;border:0.2rem solid #211e18;">' : '<span style="height:6rem;width:6rem;display:flex;align-items:center;justify-content:center;font-size:2.6rem;border:0.2rem solid #211e18;background:#f4f0e6;">🐶</span>') +
          '<div style="flex:1;min-width:14rem;">' +
          '<p style="margin:0;font-weight:800;font-size:1.7rem;">' + esc(d.dog_name) + "</p>" +
          '<p style="margin:0.2rem 0 0;font-size:1.1rem;opacity:0.6;font-weight:700;">' + esc(d.breed || "Unknown breed") + " · " + (d.lost_contact_opt_in ? "Contact public" : "Contact private") + "</p>" +
          '<p style="margin:0.4rem 0 0;font-size:1.1rem;font-weight:700;">Tag code: <span style="font-family:monospace;letter-spacing:0.2rem;border:0.2rem solid #211e18;background:#c99a2e;padding:0.1rem 0.6rem;">' + esc(d.tag_code) + "</span></p></div>" +
          '<div style="display:flex;flex-direction:column;gap:0.4rem;align-items:flex-end;">' +
          '<a href="' + LOOKUP + '?tag=' + encodeURIComponent(d.tag_code) + '" style="' + SMALL + 'color:#1fa89b;">Preview lookup →</a>' +
          '<button data-edit="' + d.id + '" style="' + SMALL + '">Edit</button>' +
          '<button data-del="' + d.id + '" style="' + SMALL + 'color:#a6332e;">Delete</button></div></div>' +
          '<div id="dgd-edit-' + d.id + '"></div></div>';
      });
      body.innerHTML = html;
      document.getElementById("dgd-m-out").addEventListener("click", function () { D.signOut(); render(); });

      // Delete: confirm, remove row (RLS scopes to owner) + photo object.
      body.querySelectorAll("button[data-del]").forEach(function (btn) {
        btn.addEventListener("click", async function () {
          var id = btn.getAttribute("data-del");
          var dog = dogs.filter(function (x) { return x.id === id; })[0];
          if (!confirm("Delete " + (dog ? dog.dog_name : "this dog") + "'s profile? This can't be undone.")) return;
          try {
            await D.del("dog_profiles?id=eq." + id, token);
            if (dog && dog.photo_path) D.removeObject("dog-photos", dog.photo_path, token);
            listView(sess);
          } catch (e) { alert(e.message); }
        });
      });

      // Edit: inline panel for breed, fun fact (moderated), contact opt-in.
      body.querySelectorAll("button[data-edit]").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var id = btn.getAttribute("data-edit");
          var slot = document.getElementById("dgd-edit-" + id);
          if (slot.innerHTML) { slot.innerHTML = ""; return; }
          var dog = dogs.filter(function (x) { return x.id === id; })[0];
          slot.innerHTML =
            '<div style="border-top:0.15rem dashed rgba(33,30,24,0.3);margin-top:1rem;padding-top:1rem;display:flex;flex-direction:column;gap:1rem;">' +
            '<label style="font-weight:700;">Breed<input style="' + I + '" id="e-breed-' + id + '" maxlength="60" value="' + esc(dog.breed || "") + '"></label>' +
            '<label style="font-weight:700;">Fun fact<textarea style="' + I + 'resize:vertical;" id="e-bio-' + id + '" rows="2" maxlength="300">' + esc(dog.bio || "") + "</textarea></label>" +
            '<label style="display:flex;gap:0.8rem;align-items:flex-start;border:0.2rem solid #211e18;padding:0.8rem;"><input type="checkbox" id="e-opt-' + id + '" style="width:1.8rem;height:1.8rem;margin-top:0.2rem;"' + (dog.lost_contact_opt_in ? " checked" : "") + '><span><strong>Lost dog contact</strong> — show my phone &amp; email on ' + esc(dog.dog_name) + '&#39;s public profile so a finder can reach me.</span></label>' +
            '<p id="e-err-' + id + '" style="color:#a6332e;font-weight:700;margin:0;"></p>' +
            '<div style="display:flex;gap:1rem;align-items:center;"><button id="e-save-' + id + '" style="' + B + '">Save changes</button><button id="e-cancel-' + id + '" style="' + SMALL + '">Cancel</button></div></div>';
          document.getElementById("e-cancel-" + id).addEventListener("click", function () { slot.innerHTML = ""; });
          document.getElementById("e-save-" + id).addEventListener("click", async function () {
            var errEl = document.getElementById("e-err-" + id), save = document.getElementById("e-save-" + id);
            errEl.textContent = ""; save.disabled = true; save.textContent = "Saving…";
            try {
              var breed = document.getElementById("e-breed-" + id).value.trim().slice(0, 60) || null;
              var bioRaw = document.getElementById("e-bio-" + id).value.trim().slice(0, 300) || null;
              var opt = document.getElementById("e-opt-" + id).checked;
              // Re-moderate only if the fun fact changed (best-effort, same as
              // registration — keeps the raw text if the function is down).
              var bio = bioRaw;
              if (bioRaw && bioRaw !== dog.bio) bio = await D.moderateBio(bioRaw, token);
              await D.update("dog_profiles?id=eq." + id, { breed: breed, bio: bio, lost_contact_opt_in: opt }, token);
              listView(sess);
            } catch (e) { errEl.textContent = e.message; save.disabled = false; save.textContent = "Save changes"; }
          });
        });
      });
    }

    async function render() {
      var sess = await D.getSession();
      if (sess) listView(sess); else authView();
    }
    render();
  }
  boot();
})();
</script>
</div>
</div>
{% schema %}
{
  "name": "My dogs",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "My dogs"
    }
  ]
}
{% endschema %}
